{
  // Ending Credits: static game (public/) + YouTube lookup + multiplayer rooms (Durable Objects). ./build.sh deploy
  "name": "endingcredits",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // endingcredits.rennko.tech/* is more specific than Rennko Cloud's *.rennko.tech/* route, so this host stays here
  "routes": [{ "pattern": "endingcredits.rennko.tech", "custom_domain": true }, { "pattern": "endingcredits.rennko.tech/*", "zone_name": "rennko.tech" }],
  "workers_dev": true
}
